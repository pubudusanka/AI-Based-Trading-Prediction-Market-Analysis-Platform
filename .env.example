# ==========================================
# AI-Based Trading Prediction Platform - ENV
# ==========================================

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Spring Boot
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ML Service (FastAPI)
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8001
ML_MODELS_PATH=./ml/models

# Frontend (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_ML_URL=http://localhost:8001

# Market Data Ingestion
PRIMARY_ASSET=BTC/USDT
PRIMARY_TIMEFRAME=15m
MARKET_DATA_PROVIDER=BINANCE
DATA_CACHE_DIR=./data/cache
